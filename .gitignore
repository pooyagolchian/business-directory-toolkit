# --- secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key
.aws/

# --- sst ---
.sst/
sst-env.d.ts

# --- node ---
node_modules/
.pnpm-store/
*.tsbuildinfo

# --- next ---
.next/
.open-next/
out/

# --- build ---
dist/
build/
coverage/

# --- crawl output: never commit the dataset ---
