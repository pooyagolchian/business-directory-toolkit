# Copy to .env and fill in. NEVER commit .env.
#
# In deployed environments these are NOT read from .env — they come from
# SSM Parameter Store via SST secrets:
#   npx sst secret set SearchApiKey   <value>
#   npx sst secret set AnthropicApiKey <value>
#
# .env is for local development and one-off scripts only.

# https://www.searchapi.io/ — Maps engine credits
SEARCH_API_KEY=

# https://console.anthropic.com/ — taxonomy classification (Haiku 4.5 + Batch API)
ANTHROPIC_API_KEY=

# Optional: override the deploy region (default us-east-1 — see
# docs/adr/0003-deploy-region.md)
# AWS_REGION=us-east-1

# --- dev tooling only (not read by the pipeline) ---
# MCP access to SearchApi from Claude Code / Cursor (server name: dubai_directory).
# This is NOT the same value as SEARCH_API_KEY — generate a separate MCP
# token at https://www.searchapi.io/mcp_integrations
# Only needed for headless/CI use; interactive clients use OAuth instead.
# SEARCHAPI_MCP_TOKEN=
