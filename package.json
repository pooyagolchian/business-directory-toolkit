{
  "name": "business-directory-toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source TypeScript toolkit for building a local business directory for any city, on SearchApi's Google Maps engine. A city is a JSON file, not a code change.",
  "license": "MIT",
  "author": "Pooya Golchian <hello@pooyagolchian.com> (https://pooyagolchian.com)",
  "homepage": "https://directory.pooyagolchian.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/pooyagolchian/business-directory-toolkit.git"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --build --pretty false && pnpm --filter @directory/web typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "plan": "tsx packages/pipeline/src/cli/plan.ts",
    "crawl": "tsx packages/pipeline/src/cli/crawl.ts",
    "classify": "tsx packages/pipeline/src/cli/classify.ts",
    "load": "tsx packages/pipeline/src/cli/load.ts",
    "deploy": "sst deploy",
    "dev": "sst dev",
    "seed-taxonomy": "tsx packages/pipeline/src/cli/seed-taxonomy.ts",
    "demand": "tsx packages/pipeline/src/cli/demand.ts",
    "reviews": "tsx packages/pipeline/src/cli/reviews.ts",
    "export": "tsx packages/pipeline/src/cli/export.ts",
    "leads": "tsx packages/pipeline/src/cli/leads.ts",
    "cities": "tsx packages/pipeline/src/cli/cities.ts",
    "dataset:push": "node scripts/dataset.mjs push",
    "dataset:pull": "node scripts/dataset.mjs pull",
    "visibility": "tsx packages/pipeline/src/cli/visibility.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.1",
    "prettier": "^3.4.2",
    "sst": "4.17.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
