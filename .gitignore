# See docs/adr/0002-do-not-redistribute-the-dataset.md
data/raw/
data/out/
*.ndjson
!fixtures/**/*.ndjson

# --- os / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- private business documents (see README note) ---
# The SearchApi proposal contains commercial terms and contact details.
# Un-ignore deliberately if you decide to publish it.
searchapi-ambassador-proposal.pdf

# --- local agent session state ---
.claude/*.local.*
.claude/settings.local.json

# --- browser automation artifacts ---
.playwright-mcp/

# build artifact: dataset copied in at prebuild, never committed
packages/web/.data/
